{
  "api_endpoints": {
    "publicos": [
      {
        "metodo": "POST",
        "endpoint": "/api/auth/register",
        "descripcion": "Registrar nuevo usuario"
      },
      {
        "metodo": "POST",
        "endpoint": "/api/auth/login",
        "descripcion": "Autenticar y obtener JWT"
      }
    ],
    "autenticados_todos": [
      {
        "metodo": "GET",
        "endpoint": "/api/auth/validate",
        "descripcion": "Validar token JWT"
      },
      {
        "metodo": "GET",
        "endpoint": "/api/instructores",
        "descripcion": "Listar todos los instructores"
      },
      {
        "metodo": "GET",
        "endpoint": "/api/instructores/{id}",
        "descripcion": "Obtener instructor por ID"
      },
      {
        "metodo": "GET",
        "endpoint": "/api/alumnos",
        "descripcion": "Listar todos los alumnos"
      },
      {
        "metodo": "GET",
        "endpoint": "/api/alumnos/{id}",
        "descripcion": "Obtener alumno por ID"
      },
      {
        "metodo": "GET",
        "endpoint": "/api/talleres",
        "descripcion": "Listar todos los talleres"
      },
      {
        "metodo": "GET",
        "endpoint": "/api/talleres/{id}",
        "descripcion": "Obtener taller por ID"
      },
      {
        "metodo": "GET",
        "endpoint": "/api/talleres/{id}/detalle-completo",
        "descripcion": "Obtener detalle completo del taller"
      }
    ],
    "solo_admin": [
      {
        "metodo": "POST",
        "endpoint": "/api/instructores",
        "descripcion": "Crear instructor"
      },
      {
        "metodo": "PUT",
        "endpoint": "/api/instructores/{id}",
        "descripcion": "Actualizar instructor"
      },
      {
        "metodo": "DELETE",
        "endpoint": "/api/instructores/{id}",
        "descripcion": "Eliminar instructor"
      },
      {
        "metodo": "POST",
        "endpoint": "/api/alumnos",
        "descripcion": "Crear alumno"
      },
      {
        "metodo": "PUT",
        "endpoint": "/api/alumnos/{id}",
        "descripcion": "Actualizar alumno"
      },
      {
        "metodo": "DELETE",
        "endpoint": "/api/alumnos/{id}",
        "descripcion": "Eliminar alumno"
      },
      {
        "metodo": "POST",
        "endpoint": "/api/alumnos/{id}/incrementar-taller",
        "descripcion": "Incrementar contador de talleres"
      },
      {
        "metodo": "POST",
        "endpoint": "/api/alumnos/{id}/decrementar-taller",
        "descripcion": "Decrementar contador de talleres"
      },
      {
        "metodo": "POST",
        "endpoint": "/api/talleres",
        "descripcion": "Crear taller"
      },
      {
        "metodo": "PUT",
        "endpoint": "/api/talleres/{id}",
        "descripcion": "Actualizar taller"
      },
      {
        "metodo": "DELETE",
        "endpoint": "/api/talleres/{id}",
        "descripcion": "Eliminar taller"
      },
      {
        "metodo": "POST",
        "endpoint": "/api/talleres/{tallerId}/asignar-instructor/{instructorId}",
        "descripcion": "Asignar instructor al taller"
      }
    ],
    "admin_o_alumno": [
      {
        "metodo": "POST",
        "endpoint": "/api/talleres/{tallerId}/inscribir-alumno/{alumnoId}",
        "descripcion": "Inscribir alumno en taller",
        "roles_permitidos": ["ADMIN", "ALUMNO"]
      },
      {
        "metodo": "POST",
        "endpoint": "/api/talleres/{tallerId}/matricular-alumno/{alumnoId}",
        "descripcion": "Matricular alumno (con saga)",
        "roles_permitidos": ["ADMIN", "ALUMNO"]
      }
    ]
  }
}
